{
  "name": "periscan",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "analyst:score:check": "node scripts/analyst-score-gate.mjs",
    "build": "pnpm -r --if-present build",
    "clean:build": "bash ./scripts/clean-build-artifacts.sh",
    "db:backup": "bash ./scripts/db-backup.sh",
    "db:restore-drill": "bash ./scripts/db-restore-drill.sh",
    "db:check-drift": "node scripts/check-enum-drift.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @periscan/api dev\" \"pnpm --filter @periscan/web dev\"",
    "dev:worker": "concurrently -n api,web,worker -c blue,green,yellow \"pnpm --filter @periscan/api dev\" \"pnpm --filter @periscan/web dev\" \"pnpm --filter @periscan/worker dev\"",
    "format": "prettier --write .",
    "licenses:check": "tsx scripts/license-inventory.ts check",
    "licenses:write": "tsx scripts/license-inventory.ts write",
    "sbom:write": "tsx scripts/generate-cyclonedx-sbom.ts",
    "lint": "pnpm -r --if-present lint",
    "modules:certify": "tsx scripts/module-certification.ts write",
    "modules:certify:check": "tsx scripts/module-certification.ts check",
    "prd:audit": "tsx scripts/prd-audit-gate.ts check",
    "prd:audit:strict": "tsx scripts/prd-audit-gate.ts strict",
    "runner:docker:build": "docker build -t periscan-runner:local apps/runner",
    "lab:up": "bash ./infra/lab/scripts/up.sh",
    "lab:down": "bash ./infra/lab/scripts/stop.sh",
    "lab:stop": "bash ./infra/lab/scripts/stop.sh",
    "lab:smoke": "bash ./infra/lab/scripts/smoke.sh",
    "lab:dev": "bash ./infra/lab/scripts/control-plane-dev.sh",
    "lab:demo-up": "bash ./infra/lab/scripts/demo-up.sh",
    "lab:demo-fixed": "bash ./infra/lab/scripts/fixed-loop.sh",
    "lab:walk-spine": "bash ./infra/lab/scripts/walk-spine.sh",
    "lab:hybrid-plant": "bash ./infra/lab/scripts/hybrid-plant-compile.sh",
    "lab:patch-signing": "bash ./infra/lab/scripts/patch-runner-signing.sh",
    "lab:cloud-up": "bash -c 'cd infra/lab && docker compose -f docker-compose.yml -f docker-compose.cloud.yml --profile cloud up -d localstack'",
    "lab:cloud-down": "bash -c 'cd infra/lab && docker compose -f docker-compose.yml -f docker-compose.cloud.yml --profile cloud stop localstack'",
    "lab:enroll-runners": "bash ./infra/lab/scripts/enroll-runners.sh",
    "lab:schedule-plant": "bash ./infra/lab/scripts/schedule-plant.sh",
    "lab:drain-queue": "PERISCAN_LAB_DRAIN_QUEUE=1 bash ./infra/lab/scripts/drain-validation-queue.sh",
    "seed:demo": "pnpm --filter @periscan/db db:seed:demo",
    "settled:check": "node scripts/settled-tripwire.mjs",
    "secrets:scan": "gitleaks detect --source . --no-git",
    "test:acceptance": "vitest run tests/acceptance --testTimeout=60000",
    "test:e2e": "playwright test",
    "test:license": "vitest run tests/license",
    "test:modules": "vitest run tests/modules",
    "test:runner": "bash ./scripts/test-runner.sh",
    "test:runner:deploy": "bash ./scripts/validate-runner-deploy.sh",
    "test:runner:lab": "bash ./scripts/test-runner-lab.sh",
    "test:security": "vitest run tests/security",
    "verify:api": "pnpm --filter @periscan/api typecheck && pnpm --filter @periscan/api test",
    "verify": "bash ./scripts/verify.sh",
    "test": "pnpm -r --if-present test",
    "tools:check": "tsx scripts/oss-toolchain.ts check",
    "tools:list": "tsx scripts/oss-toolchain.ts list",
    "tools:pull": "tsx scripts/oss-toolchain.ts pull",
    "tools:qualify:proof": "tsx scripts/qualify-oss-proof-engines.ts",
    "tools:qualify:agent-trust": "tsx scripts/qualify-agent-trust-oss.ts",
    "connectors:qual:dry-run": "tsx scripts/connector-production-qual-dry-run.ts",
    "typecheck": "pnpm --filter @periscan/db run db:generate && pnpm -r --if-present typecheck",
    "lab:sync": "bash ./scripts/sync-staging-to-datassd1.sh",
    "lab:pull-staging": "bash ./scripts/pull-from-datassd1.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "fast-xml-parser": "5.7.3",
      "find-my-way": "9.7.0",
      "postcss": "8.5.23",
      "sharp": "0.35.3",
      "shell-quote": "1.10.0",
      "undici": "7.28.0"
    }
  }
}
