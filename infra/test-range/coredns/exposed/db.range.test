; EXPOSED zone — deliberately weak DNS posture.
$ORIGIN range.test.
$TTL 60
@   IN SOA ns.range.test. admin.range.test. ( 2024010101 7200 3600 1209600 60 )
@       IN NS    ns.range.test.
ns      IN A     127.0.0.1

; HTTP/TLS hosts resolve to the local nginx.
app     IN A     127.0.0.1
cert    IN A     127.0.0.1

; Dangling CNAME: points at a name with NO address ->
; periscan.dns_resolution_check -> Validated (dns_dangling_cname).
dangling IN CNAME ghost.range.test.
; ghost.range.test intentionally has NO A record.

; NO CAA record for app -> periscan.dns_caa_check -> Validated (dns_caa_missing).
; NO SPF TXT on app and NO DMARC TXT at _dmarc.app ->
;   periscan.dns_email_security_check -> Validated (email_security_misconfigured).
