# Copy to /etc/periscan/runner-agent.env with mode 0600.
# Values are issued by Periscan Cloud during runner registration.

PERISCAN_CONTROL_PLANE_URL=https://api.periscan.cloud
PERISCAN_RUNNER_ID=replace-with-issued-runner-id
# bearer auth token issued by Periscan Cloud for outbound HTTPS polling.
PERISCAN_RUNNER_AUTH_TOKEN=replace-with-issued-runner-auth-token
# mTLS material issued during registration/rotation and stored as local files.
# The client private key is generated locally by the runner and is not sent to Periscan Cloud.
PERISCAN_RUNNER_MTLS_CA_FILE=/etc/periscan/runner-ca.pem
PERISCAN_RUNNER_MTLS_CLIENT_CERT_FILE=/etc/periscan/runner-client.pem
PERISCAN_RUNNER_MTLS_CLIENT_KEY_FILE=/etc/periscan/runner-client.key
PERISCAN_TASK_SIGNING_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace-with-task-signing-public-key\n-----END PUBLIC KEY-----"

# Optional outbound proxy for restrictive firewalls.
PERISCAN_RUNNER_PROXY_URL=

# Emergency stop. Setting this to true causes the runner to refuse execution.
PERISCAN_RUNNER_KILL_SWITCH=false

# Runner-agent measured modules require the AgentLocal image (not the thin Go runner).
# ServiceViaProxy control-plane channel is NotAvailable (P10-4) — do not claim product readiness.

