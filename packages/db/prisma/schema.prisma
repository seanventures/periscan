model EvidenceArtifact {
  evidenceId        String               @id @default(uuid()) @map("evidence_id") @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  artifactType      EvidenceArtifactType @map("artifact_type")
  storageUri        String               @map("storage_uri")
  sha256            String
  sensitivityLevel  SensitivityLevel     @map("sensitivity_level")
  redactionStatus   RedactionStatus      @map("redaction_status")
  relatedEntityType RelatedEntityType    @map("related_entity_type")
  relatedEntityId   String               @map("related_entity_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  // Tamper-evident hash chain (per tenant). chainSeq is a per-tenant monotonic
  // position; chainHash binds this row's content (sha256) + metadata to the
  // predecessor's chainHash, so unauthorized hard-deletes/mutations of a middle
  // row break every link after it. Authorized retention purge MUST keep this
  // row (tombstone storageUri to periscan://retention-purged/<id>) so the chain
  // stays contiguous. Nullable because rows written before the chain migration
  // are unchained legacy (their per-record sha256 still verifies independently).
  chainSeq          BigInt?              @map("chain_seq")
  prevChainHash     String?              @map("prev_chain_hash")
  chainHash         String?              @map("chain_hash")
  // Authorized post-ingest redaction. The chain (sha256/chainHash) always attests
  // to what was INGESTED; a later operator redaction rewrites the stored blob for
  // data-minimization WITHOUT rewriting history. redactedSha256 is the hash of the
  // redacted copy so its own integrity stays verifiable, and redactedAt records
  // when the authorized redaction happened.
  redactedAt        DateTime?            @map("redacted_at")
  redactedSha256    String?              @map("redacted_sha256")
  tenant            Tenant               @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, chainSeq])
  @@index([tenantId, createdAt])
  @@index([tenantId, relatedEntityType, relatedEntityId])
  @@map("evidence_artifacts")
}

