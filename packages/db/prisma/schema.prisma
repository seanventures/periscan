model Tenant {
  tenantId                               String                                  @id @default(uuid()) @map("tenant_id") @db.Uuid
  name                                   String
  type                                   TenantType
  parentTenantId                         String?                                 @map("parent_tenant_id") @db.Uuid
  billingAccountId                       String?                                 @map("billing_account_id")
  // Provider-agnostic subscription assignment: the BillingPackage key this
  // tenant is on (resolved against BILLING_PACKAGE_CATALOG for entitlement
  // checks). Defaults to the entry tier; null = unsubscribed (entitled to none).
  billingPackageKey                      String?                                 @default("ValidationSnapshot") @map("billing_package_key")
  trialStatus                            String                                  @default("NotStarted") @map("trial_status")
  trialStartedAt                         DateTime?                               @map("trial_started_at")
  trialEndsAt                            DateTime?                               @map("trial_ends_at")
  trialActivatedBy                       String?                                 @map("trial_activated_by") @db.Uuid
  trialPreviousBillingPackageKey         String?                                 @map("trial_previous_billing_package_key")
  trialRetentionDays                     Int                                     @default(30) @map("trial_retention_days")
  trialDeletionScheduledAt               DateTime?                               @map("trial_deletion_scheduled_at")
  trialConvertedAt                       DateTime?                               @map("trial_converted_at")
  trialConversionApprovalRef             String?                                 @map("trial_conversion_approval_ref")
  trialCancelledAt                       DateTime?                               @map("trial_cancelled_at")
  trialCancellationReason                String?                                 @map("trial_cancellation_reason")
  dataRegion                             String                                  @map("data_region")
  preferredLocale                        String                                  @default("en-US") @map("preferred_locale")
  preferredTimeZone                      String                                  @default("UTC") @map("preferred_time_zone")
  threatFeedFrequency                    ScheduleFrequency?                      @map("threat_feed_frequency")
  nextThreatFeedIngestAt                 DateTime?                               @map("next_threat_feed_ingest_at")
  // Offensive-validation authorization flip. OFF by default: the policy engine
  // caps this tenant at BASLite. When an admin explicitly authorizes it (with a
  // recorded attestation reference), the effective ceiling rises to
  // AdvancedAdversarial so adversarial validation can run and honestly earn
  // "Exploitable". The hard policy floor (destructive / exfiltration /
  // persistence / credential-theft / uncontrolled-chaining) always stays denied.
  offensiveValidationEnabled             Boolean                                 @default(false) @map("offensive_validation_enabled")
  offensiveValidationAuthorizedBy        String?                                 @map("offensive_validation_authorized_by") @db.Uuid
  offensiveValidationAuthorizedAt        DateTime?                               @map("offensive_validation_authorized_at")
  offensiveValidationAuthorizationRef    String?                                 @map("offensive_validation_authorization_ref")
  // Destructive-validation authorization tier — the top tier above the offensive
  // flip. OFF by default. When an admin enables it (with a recorded attestation),
  // the policy engine permits governed destructive / real-payload validation,
  // still gated on verified scope + admin + per-mission approval + audit.
  destructiveValidationEnabled           Boolean                                 @default(false) @map("destructive_validation_enabled")
  destructiveValidationAuthorizedBy      String?                                 @map("destructive_validation_authorized_by") @db.Uuid
  destructiveValidationAuthorizedAt      DateTime?                               @map("destructive_validation_authorized_at")
  destructiveValidationAuthorizationRef  String?                                 @map("destructive_validation_authorization_ref")
  // Force-MFA for password auth: when true (or PERISCAN_REQUIRE_MFA=true),
  // password sessions without enrolled MFA are limited to the MFA setup path.
  // SSO is unaffected. Default off so existing tenants keep current behavior.
  requireMfa                             Boolean                                 @default(false) @map("require_mfa")
  // Durable model-gateway kill switch. When active, no new model sessions or
  // LLM tool calls are accepted until an admin clears it. Global env
  // PERISCAN_MODEL_GATEWAY_KILL_SWITCH=true forces active for every tenant.
  modelGatewayKillSwitchActive           Boolean                                 @default(false) @map("model_gateway_kill_switch_active")
  modelGatewayKillSwitchReason           String?                                 @map("model_gateway_kill_switch_reason")
  modelGatewayKillSwitchActivatedAt      DateTime?                               @map("model_gateway_kill_switch_activated_at")
  modelGatewayKillSwitchActivatedBy      String?                                 @map("model_gateway_kill_switch_activated_by") @db.Uuid
  createdAt                              DateTime                                @default(now()) @map("created_at")
  updatedAt                              DateTime                                @updatedAt @map("updated_at")
  parentTenant                           Tenant?                                 @relation("TenantHierarchy", fields: [parentTenantId], references: [tenantId])
  childTenants                           Tenant[]                                @relation("TenantHierarchy")
  memberships                            Membership[]
  scopes                                 Scope[]
  integrations                           Integration[]
  awsMarketplaceSubscription             AwsMarketplaceSubscription?
