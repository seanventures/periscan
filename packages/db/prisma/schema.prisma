// Analyst disposition overlay for DERIVED findings. Findings have no table of
// their own — they are recomputed from attack paths + signals — so findingId
// here is the stable derived id (pathId or signalId), intentionally NOT a
// foreign key. A disposition never changes the derived status (Fixed stays
// verification-only); it records a human triage decision. One per finding.
model FindingDisposition {
  findingDispositionId String    @id @default(uuid()) @map("finding_disposition_id") @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  findingId            String    @map("finding_id")
  disposition          String
  note                 String?
  ownerId              String?   @map("owner_id") @db.Uuid
  expiresAt            DateTime? @map("expires_at")
  approvedBy           String?   @map("approved_by") @db.Uuid
  approvedAt           DateTime? @map("approved_at")
  updatedBy            String    @map("updated_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  tenant               Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, findingId])
  @@index([tenantId])
  @@map("finding_dispositions")
}

// HTTP Idempotency-Key records for core proof-loop POSTs (P20-7).
// Unique per (tenant, route, key); bodyHash must match on replay or clients
// receive 409 idempotency_key_conflict. responseBody is the first successful
// JSON payload (statusCode 2xx–4xx). TTL cleanup is app-side (expiresAt).
model ApiIdempotencyRecord {
  apiIdempotencyRecordId String   @id @default(uuid()) @map("api_idempotency_record_id") @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  route                  String
  idempotencyKey         String   @map("idempotency_key")
  bodyHash               String   @map("body_hash")
  statusCode             Int      @map("status_code")
  responseBody           String   @map("response_body") @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  expiresAt              DateTime @map("expires_at")
  tenant                 Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, route, idempotencyKey])
  @@index([tenantId, expiresAt])
  @@index([expiresAt])
  @@map("api_idempotency_records")
}

