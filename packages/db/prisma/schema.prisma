// ---------------------------------------------------------------------------
// Global threat-intelligence catalog ("super feed").
//
// Unlike ThreatAdvisory (which is tenant-scoped curation), these tables are
// GLOBAL (no tenantId): world threat data — CVEs, IOCs, advisories — is the
// same for every tenant, so it is ingested ONCE, deduped across all feeds by a
// stable canonicalKey, and correlated to each tenant on read. Provenance rows
// record which feeds reported each canonical item.
// ---------------------------------------------------------------------------

enum ThreatIntelKind {
  Vulnerability
  Indicator
  Advisory
}

// One canonical, cross-feed-deduped threat record. canonicalKey is the dedup
// identity (e.g. "cve:CVE-2026-1234", "ioc:ipv4:1.2.3.4", "ioc:sha256:<hash>",
// "advisory:cisa:AA26-001A"). Re-reports from any feed UPSERT this row (union
// cveIds/techniqueIds/tags, raise severity/kev, bump lastSeenAt + sourceCount).
model ThreatIntelItem {
  threatIntelItemId String                  @id @default(uuid()) @map("threat_intel_item_id") @db.Uuid
  kind              ThreatIntelKind
  canonicalKey      String                  @unique @map("canonical_key")
  title             String
  summary           String                  @default("")
  cveIds            String[]                @default([]) @map("cve_ids")
  cvssScore         Float?                  @map("cvss_score")
  epssScore         Float?                  @map("epss_score")
  severity          String?
  kev               Boolean                 @default(false)
  kevRansomware     Boolean                 @default(false) @map("kev_ransomware")
  iocType           String?                 @map("ioc_type")
  iocValue          String?                 @map("ioc_value")
  techniqueIds      String[]                @default([]) @map("technique_ids")
  tags              String[]                @default([])
  sourceCount       Int                     @default(0) @map("source_count")
  publishedAt       DateTime?               @map("published_at")
  firstSeenAt       DateTime                @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime                @default(now()) @map("last_seen_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  provenance        ThreatIntelProvenance[]
  tenantAlerts      TenantThreatAlert[]

  @@index([kind, lastSeenAt])
  @@index([kind, severity])
  @@index([kev])
  @@index([firstSeenAt])
  @@index([iocType, iocValue])
  @@map("threat_intel_items")
}

// Which feed reported a canonical item (source attribution for dedup). One row
// per (item, sourceKey): the same CVE reported by NVD + KEV + GHSA yields one
// ThreatIntelItem with three provenance rows.
model ThreatIntelProvenance {
  threatIntelProvenanceId String          @id @default(uuid()) @map("threat_intel_provenance_id") @db.Uuid
  threatIntelItemId       String          @map("threat_intel_item_id") @db.Uuid
  sourceKey               String          @map("source_key")
  externalId              String?         @map("external_id")
  sourceUrl               String?         @map("source_url")
  reportedAt              DateTime        @default(now()) @map("reported_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  item                    ThreatIntelItem @relation(fields: [threatIntelItemId], references: [threatIntelItemId], onDelete: Cascade)

  @@unique([threatIntelItemId, sourceKey], map: "threat_intel_provenance_item_source")
  @@index([sourceKey, reportedAt])
  @@map("threat_intel_provenance")
}

// Per-feed ingestion state for the high-frequency poller: when to poll next,
// the cursor (etag/last-modified/pagination), and the last outcome. The feed
// definitions themselves are code-defined (a registry), not stored here.
model ThreatIntelSourceState {
  threatIntelSourceStateId String    @id @default(uuid()) @map("threat_intel_source_state_id") @db.Uuid
  sourceKey                String    @unique @map("source_key")
  enabled                  Boolean   @default(true)
  lastPolledAt             DateTime? @map("last_polled_at")
  nextPollAt               DateTime  @default(now()) @map("next_poll_at")
  cursor                   String?
  lastItemCount            Int       @default(0) @map("last_item_count")
  lastNewCount             Int       @default(0) @map("last_new_count")
  lastStatus               String?   @map("last_status")
  lastError                String?   @map("last_error")
  consecutiveErrors        Int       @default(0) @map("consecutive_errors")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@index([enabled, nextPollAt])
  @@map("threat_intel_source_states")
}

enum TenantThreatAlertStatus {
  New
  Acknowledged
  Dismissed
}

// A per-tenant notice that a FRESH global catalog item correlates to that
// tenant's attack surface — a verified-scope domain/IP that just appeared on a
// malware/phishing/Tor feed, or a CVE the tenant already tracks that just hit
// NVD/KEV. Deduped one-per (tenant, item); the realtime "watch" surface.
model TenantThreatAlert {
  tenantThreatAlertId String                  @id @default(uuid()) @map("tenant_threat_alert_id") @db.Uuid
  tenantId            String                  @map("tenant_id") @db.Uuid
  threatIntelItemId   String                  @map("threat_intel_item_id") @db.Uuid
  matchType           String                  @map("match_type")
  matchedValue        String                  @map("matched_value")
  matchedScopeId      String?                 @map("matched_scope_id") @db.Uuid
  severity            String?
  status              TenantThreatAlertStatus @default(New)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  tenant              Tenant                  @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  item                ThreatIntelItem         @relation(fields: [threatIntelItemId], references: [threatIntelItemId], onDelete: Cascade)

  @@unique([tenantId, threatIntelItemId], map: "tenant_threat_alerts_dedup")
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@map("tenant_threat_alerts")
}

// Persisted operator proposals (P11-4). Full recommendation body lives in
// payload Json so the domain OperatorRecommendation shape can evolve without
// migrations; status is first-class for list/filter and approval lineage.
model OperatorRecommendation {
  operatorRecommendationId String                        @id @default(uuid()) @map("operator_recommendation_id") @db.Uuid
  tenantId                 String                        @map("tenant_id") @db.Uuid
  scopeId                  String?                       @map("scope_id") @db.Uuid
  payload                  Json
  status                   OperatorRecommendationStatus
  createdAt                DateTime                      @default(now()) @map("created_at")
  tenant                   Tenant                        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  scope                    Scope?                        @relation(fields: [scopeId], references: [scopeId], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, scopeId])
  @@map("operator_recommendations")
}
