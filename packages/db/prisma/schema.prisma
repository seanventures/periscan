  @@index([tenantId, createdAt])
  @@index([tenantId, sourceNodeId])
  @@index([tenantId, targetNodeId])
  @@map("graph_edges")
}

// How a path's downstream reachability was established. Measured = derived from
// authoritative configuration or an observed probe; Heuristic = inferred from a
// known attack pattern (impactScore is then an estimate, not a measurement).
enum EvidenceBasis {
  Measured
  Heuristic
}

