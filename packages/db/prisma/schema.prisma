// Slice 3: immutable measurement receipt for a single path hop. Path certainty
// is recomputed from receipts; unrelated edges are never upgraded by association.
model PathEdgeReceipt {
  receiptId         String          @id @default(uuid()) @map("receipt_id") @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  pathId            String          @map("path_id") @db.Uuid
  pathEdgeId        String          @map("path_edge_id") @db.Uuid
  hopKey            String          @map("hop_key")
  validationRunId   String?         @map("validation_run_id") @db.Uuid
  missionId         String?         @map("mission_id") @db.Uuid
  policyDecisionId  String?         @map("policy_decision_id") @db.Uuid
  moduleId          String          @map("module_id")
  outcome           String
  validationState   ValidationState @map("validation_state")
  evidenceIds       String[]        @map("evidence_ids") @db.Uuid
  measuredAt        DateTime        @map("measured_at")
  measurementMethod String          @map("measurement_method")
  integrityHash     String?         @map("integrity_hash")
  actor             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  tenant            Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  attackPath        AttackPath      @relation(fields: [pathId], references: [pathId], onDelete: Cascade)
  pathEdge          PathEdge        @relation(fields: [pathEdgeId], references: [pathEdgeId], onDelete: Cascade)
  validationRun     ValidationRun?  @relation(fields: [validationRunId], references: [runId], onDelete: SetNull)
  mission           ValidationMission? @relation(fields: [missionId], references: [missionId], onDelete: SetNull)
  policyDecision    PolicyDecision? @relation(fields: [policyDecisionId], references: [policyDecisionId], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, pathId])
  @@index([pathEdgeId, measuredAt])
  @@index([hopKey])
  @@map("path_edge_receipts")
}

