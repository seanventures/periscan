{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OverlyPermissive",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "MalformedArn",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:iam::123456789012:not-a-valid-s3-arn"
    }
  ]
}
