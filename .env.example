PERISCAN_WEB_PORT=3000
PERISCAN_API_PORT=3001
# Local web->API proxy target. Production web deployments must set this
# explicitly; the Next.js proxy refuses to default to 127.0.0.1 in production.
PERISCAN_API_URL=http://127.0.0.1:3001
# Web-only local/demo lab switch. Production/customer workspaces should keep
# fixture connector shortcuts hidden and use API-backed live connector setup.
NEXT_PUBLIC_PERISCAN_ENABLE_FIXTURE_CONNECTORS=false
PERISCAN_DATA_REGION=us-east-1
# Local/development fixture mode only. Production startup, worker startup, and
# deployment readiness reject PERISCAN_DEV_MODE=true.
PERISCAN_DEV_MODE=true
# Development default only. Production startup and deployment readiness reject
# this value; set a strong, unique secret in production.
# Session cookies are HS256 JWTs with a `kid` header (default sess-v1). For
# zero-downtime rotation set PERISCAN_JWT_SECRET_PREVIOUS to the prior secret
# (kid sess-v0 by default) so existing sessions dual-verify until they expire.
PERISCAN_JWT_SECRET=periscan-dev-session-secret
# PERISCAN_JWT_KID=sess-v1
# PERISCAN_JWT_SECRET_PREVIOUS=
# PERISCAN_JWT_PREVIOUS_KID=sess-v0
PERISCAN_RUNNER_CONTROL_PLANE_URL=https://runner.periscan.cloud
# Production deployment readiness requires a stable Ed25519 private key PEM for
# runner task signatures. Public key and key ID are optional because the API can
# derive stable values from the private key.
PERISCAN_RUNNER_TASK_SIGNING_PRIVATE_KEY_PEM=
PERISCAN_RUNNER_TASK_SIGNING_PUBLIC_KEY_PEM=
PERISCAN_RUNNER_TASK_SIGNING_KEY_ID=
# Customer-side runner container variables. These are not used by the SaaS apps directly.
PERISCAN_RUNNER_IMAGE_TAG=latest
PERISCAN_CONTROL_PLANE_URL=https://api.periscan.cloud
PERISCAN_RUNNER_ID=
PERISCAN_RUNNER_AUTH_TOKEN=
PERISCAN_RUNNER_TENANT_ID=
PERISCAN_RUNNER_VERSION=0.1.0
PERISCAN_RUNNER_POLL_INTERVAL_SECONDS=30
# ISO-8601 expiry reported with every poll when the deployment wrapper has it.
PERISCAN_RUNNER_CERTIFICATE_EXPIRES_AT=
PERISCAN_TASK_SIGNING_PUBLIC_KEY_PEM=
PERISCAN_RUNNER_CA_CERTIFICATE_PEM=
PERISCAN_RUNNER_CERTIFICATE_PEM=
PERISCAN_RUNNER_KEY_PEM=
PERISCAN_RUNNER_PROXY_URL=
PERISCAN_RUNNER_KILL_SWITCH=false
# Local development default. Production must set DATABASE_URL or one of the
# Supabase/Postgres aliases below; the app refuses this fallback in production.
DATABASE_URL=postgresql://periscan:periscan@127.0.0.1:5432/periscan
# Periscan local postgres published port is configurable to avoid conflicts with other
# postgres containers (e.g. healthcopilot or other projects on host 5432).
# Internal service hostname inside compose network is always 'postgres'.
# Default keeps 5432 for standard use (backward compat).
# To run acceptance/verify when 5432 conflict:
#   export PERISCAN_POSTGRES_PUBLISHED_PORT=5434
#   docker compose -f infra/docker-compose/docker-compose.yml up -d
#   export DATABASE_URL=postgresql://periscan:periscan@127.0.0.1:5434/periscan
#   # or for tests only: export PERISCAN_TEST_DATABASE_URL=postgresql://periscan:periscan@127.0.0.1:5434/periscan
#   pnpm test:acceptance
#   # (then pnpm verify or targeted)
PERISCAN_POSTGRES_PUBLISHED_PORT=5432
# Redis/MinIO published ports are also overridable for host conflicts:
#   export PERISCAN_REDIS_PUBLISHED_PORT=6390
#   export PERISCAN_MINIO_PUBLISHED_PORT=9010
PERISCAN_REDIS_PUBLISHED_PORT=6379
PERISCAN_MINIO_PUBLISHED_PORT=9000
# Optional explicit DB URL override used only by test runners (vitest / NODE_ENV=test)
# for acc/verify when using alt published port. See guidance above.
PERISCAN_TEST_DATABASE_URL=
# Local development default. Production API/worker/webhook queues require an
# explicit redis:// or rediss:// REDIS_URL and refuse this fallback.
REDIS_URL=redis://127.0.0.1:6379
# Per-tenant queue backpressure: max pending (waiting/active/delayed) validation
# jobs a single tenant may have before new enqueues are denied with HTTP 429
# (so one tenant can't starve the shared queue). Unset = no cap.
PERISCAN_QUEUE_MAX_PER_TENANT=
# Validation queue retry policy (worker + API enqueue).
PERISCAN_QUEUE_MAX_ATTEMPTS=3
PERISCAN_QUEUE_BACKOFF_MS=5000
PERISCAN_WORKER_CONCURRENCY=4
# Frontier Gateway (model gateway).
# Master key used to encrypt customer-supplied frontier-model API keys at rest
# (AES-256-GCM). Production MUST set a strong, stable value and does not fall
# back to PERISCAN_JWT_SECRET. Rotating this key invalidates stored provider
# credentials (customers must re-enter their API keys).
PERISCAN_MODEL_CREDENTIAL_KEY=
# Master key used to encrypt integration connector credentials at rest. Production
# MUST set a strong, stable value separate from PERISCAN_JWT_SECRET and
# PERISCAN_MODEL_CREDENTIAL_KEY.
PERISCAN_INTEGRATION_CREDENTIAL_KEY=
# Operator attestation that evidence object storage is encrypted at rest
# (platform-managed KMS/SSE or customer CMK). Production boot fails closed if
# unset or set to a placeholder (todo/none/false). Surface-only declaration —
# the object store itself must still be configured for encryption.
# PERISCAN_EVIDENCE_ENCRYPTION_AT_REST=platform-managed-sse-s3
# Default model name used for a turn when a session/provider does not specify one.
PERISCAN_MODEL_GATEWAY_DEFAULT_MODEL=gpt-4o-mini
# Global feature-flag force-on for the durable model-gateway kill path. When true,
# every tenant refuses new model sessions and LLM tool calls (in addition to any
# per-tenant kill switch set via POST /api/v1/model-gateway/kill-switch).
PERISCAN_MODEL_GATEWAY_KILL_SWITCH=false
# model-gateway-turns queue retry policy.
PERISCAN_MODEL_GATEWAY_TURN_MAX_ATTEMPTS=3
PERISCAN_MODEL_GATEWAY_TURN_BACKOFF_MS=5000
# Force Secure cookies outside production (production forces this on automatically).
PERISCAN_COOKIE_SECURE=false
# Secret used to sign unauthenticated public report-share links. Production MUST
# set a strong value separate from PERISCAN_JWT_SECRET. Tokens carry kid
# share-v1; set PERISCAN_REPORT_SHARE_SECRET_PREVIOUS during rotation.
PERISCAN_REPORT_SHARE_SECRET=
# PERISCAN_REPORT_SHARE_KID=share-v1
# PERISCAN_REPORT_SHARE_SECRET_PREVIOUS=
# PERISCAN_REPORT_SHARE_PREVIOUS_KID=share-v0
# HMAC secret for model-tool intervention tokens. Production MUST set a strong
# value separate from PERISCAN_JWT_SECRET (purpose-split residual closed).
# PERISCAN_INTERVENTION_SIGNING_SECRET=
# CSRF double-submit for cookie sessions (periscan_csrf + x-csrf-token).
# Default: enforced outside vitest/test. Set true to force in tests.
# false disables only outside production; PERISCAN_DEPLOYMENT_ENVIRONMENT=production
# refuses PERISCAN_CSRF_ENFORCE=false (startup error + hard-ignore in isCsrfEnforced).
# PERISCAN_CSRF_ENFORCE=
# Transactional email (invites, password reset, email verification).
# Transport: smtp (production delivery) | console (dev only — logs instead of
# sending) | noop (intentional drop). Production MUST set this explicitly and
# cannot use console.
PERISCAN_EMAIL_TRANSPORT=console
# Default From address for all platform email. Production SMTP MUST set a
# deliverable sender address.
PERISCAN_EMAIL_FROM=Periscan <no-reply@periscan.local>
# SMTP transport settings (used only when PERISCAN_EMAIL_TRANSPORT=smtp).
# Any RFC-compliant provider works (SES, SendGrid, Postmark, Mailgun, self-host).
# secure defaults to true on port 465 (implicit TLS), false otherwise (STARTTLS).
PERISCAN_SMTP_HOST=
PERISCAN_SMTP_PORT=587
PERISCAN_SMTP_SECURE=
PERISCAN_SMTP_USER=
PERISCAN_SMTP_PASSWORD=
# Base URL used to build links in email (password-reset / invite / verify).
# Production MUST set a public HTTPS URL.
PERISCAN_WEB_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API directly (external UI).
# Production values must be public HTTPS origins only; wildcard, localhost,
# non-HTTPS, path, query, fragment, or credential-bearing origins fail closed.
PERISCAN_CORS_ORIGINS=
# API rate limiting: global requests per window, the window length, and a
# stricter cap on auth endpoints to slow credential stuffing.
PERISCAN_RATE_LIMIT_MAX=600
PERISCAN_RATE_LIMIT_WINDOW=1 minute
# Trust X-Forwarded-For / client IP from the reverse-proxy edge for rate-limit
# keying and request.ip. true|false|1|0 or hop count (e.g. 1). Default true when
# PERISCAN_DEPLOYMENT_ENVIRONMENT=production; false otherwise. Only enable when
# the API is not client-reachable without that edge.
# PERISCAN_TRUST_PROXY=true
# Per-user account lockout (complements rate limiting): lock after N consecutive
# failed logins, for M minutes. A successful login or password reset clears it.
PERISCAN_LOGIN_MAX_ATTEMPTS=5
PERISCAN_LOGIN_LOCKOUT_MINUTES=15
PERISCAN_AUTH_RATE_LIMIT_MAX=20
# Optional soft usage limits surfaced by GET /api/v1/billing/limits (unset = unlimited).
PERISCAN_LIMIT_MISSIONS_PER_MONTH=
PERISCAN_LIMIT_RUNNERS=
PERISCAN_LIMIT_EVIDENCE_ARTIFACTS=
# AWS Marketplace SaaS integration. Leave product code empty until Seller
# Operations has issued a real limited-listing product code. Listing state is
# honest external state: IntegrationReady, Limited, or Public. Dimension JSON
# maps Periscan usage meter names to listing dimension API names; package JSON
# maps entitlement dimensions to Periscan billing package keys.
PERISCAN_AWS_MARKETPLACE_PRODUCT_CODE=
PERISCAN_AWS_MARKETPLACE_LISTING_STATE=NotConfigured
PERISCAN_AWS_MARKETPLACE_DIMENSIONS_JSON={}
PERISCAN_AWS_MARKETPLACE_PACKAGE_MAP_JSON={}
# Provider verifier public keys keyed by AWSNitro, AzureTDX, AMDSEVSNP, or
# NvidiaConfidentialGPU. NVIDIA production verification expects an NVAT ES384
# relying-party public key; encode PEM line breaks as \n inside the JSON value.
PERISCAN_ATTESTATION_TRUST_ANCHORS_JSON={}
# Local MinIO shortcuts are for development only. Production evidence storage
# must use the explicit PERISCAN_EVIDENCE_S3_* variables below (or Supabase
# storage aliases in deployment config), not MINIO_ROOT_* fallback values.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=periscan
MINIO_ROOT_PASSWORD=periscan123
MINIO_BUCKET=periscan-evidence
PERISCAN_EVIDENCE_S3_ENDPOINT=
PERISCAN_EVIDENCE_S3_BUCKET=
PERISCAN_EVIDENCE_S3_ACCESS_KEY_ID=
PERISCAN_EVIDENCE_S3_SECRET_ACCESS_KEY=
PERISCAN_EVIDENCE_S3_FORCE_PATH_STYLE=
PERISCAN_EVIDENCE_S3_REGION=
# Optional deployment-managed evidence retention disclosure for the Trust & Safety API.
PERISCAN_EVIDENCE_RETENTION_DAYS=
# Supabase compatibility aliases (optional). If DATABASE_URL is set, it takes
# precedence. Production may use SUPABASE_DATABASE_URL, SUPABASE_DB_URL, or
# POSTGRES_URL instead of DATABASE_URL, but one explicit database URL is required.
SUPABASE_DB_URL=
SUPABASE_DATABASE_URL=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_FORCE_PATH_STYLE=
SUPABASE_STORAGE_REGION=
# Trust & Safety legal pack (DPA / BAA / subprocessors / vendor SOC 2).
# Empty subprocessors means NotConfigured disclosure — never a claim of zero subprocessors.
# PERISCAN_DPA_REFERENCE_URL=https://trust.example.com/dpa-v1.pdf
# PERISCAN_BAA_REFERENCE_URL=https://trust.example.com/baa-customer.pdf
# PERISCAN_SUBPROCESSORS_JSON=[{"name":"Amazon Web Services","purpose":"Control plane and storage","privacyUrl":"https://aws.amazon.com/privacy/"}]
# Vendor SOC 2 Type II only: None | InProgress | ReportUnderNda (default None).
# PERISCAN_VENDOR_SOC2_STATUS=None

# Optional production operational-readiness disclosures for the Trust & Safety API.
# Use descriptive labels/cadences only. Do not put webhook URLs, credentials, or tokens here.
PERISCAN_DEPLOYMENT_ENVIRONMENT=
PERISCAN_DATABASE_BACKUP_CADENCE=
PERISCAN_DATABASE_RESTORE_TESTED_AT=
PERISCAN_OBJECT_STORAGE_RETENTION_DAYS=
PERISCAN_OBJECT_STORAGE_BACKUP_POLICY=
PERISCAN_REDIS_PERSISTENCE_MODE=
PERISCAN_LOG_AGGREGATION_TARGET=
PERISCAN_ALERT_ROUTING_TARGET=
PERISCAN_INCIDENT_CONTACT=

# Internal OSS toolchain configuration.
PERISCAN_OSS_TOOL_HOME=.periscan/oss
# Third-party tool install governance. The API queues install jobs; only a
# platform-controlled worker with worker + execute flags enabled runs docker/git/pip
# pulls from reviewed tool manifests. Leave both false in normal development.
PERISCAN_THIRD_PARTY_TOOL_INSTALL_WORKER_ENABLED=false
PERISCAN_THIRD_PARTY_TOOL_INSTALL_WORKER_INTERVAL_MS=60000
PERISCAN_THIRD_PARTY_TOOL_INSTALL_EXECUTE=false
PERISCAN_GITLEAKS_RUNTIME=docker
PERISCAN_GITLEAKS_VERSION=v8.30.0
PERISCAN_NUCLEI_RUNTIME=docker
PERISCAN_NUCLEI_VERSION=v3.8.0
PERISCAN_NUCLEI_TEMPLATES_RUNTIME=git
PERISCAN_NUCLEI_TEMPLATES_VERSION=v10.4.4
PERISCAN_EXTERNAL_VALIDATION_KILL_SWITCH=false
PERISCAN_EXTERNAL_VALIDATION_TENANT_LIMIT=25
PERISCAN_EXTERNAL_VALIDATION_GLOBAL_LIMIT=100
PERISCAN_EXTERNAL_VALIDATION_WINDOW_MS=60000
PERISCAN_EXTERNAL_VALIDATION_BLOCKED_TARGETS=
PERISCAN_TRIVY_RUNTIME=docker
PERISCAN_TRIVY_VERSION=0.70.0
PERISCAN_PROWLER_RUNTIME=docker
PERISCAN_PROWLER_VERSION=5.28.1
